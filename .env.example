# --- Supabase (Project Settings > API) ---
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
# "service_role" key — SERVER ONLY. Never expose it to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# --- Service venue (from Google Maps: right click > copy coordinates) ---
CHURCH_LAT=-15.8134283
CHURCH_LNG=-47.8435832
# Accepted radius in meters (phone GPS indoors is off by 20-60 m)
CHURCH_RADIUS_METERS=150
# Test mode: "true" turns off the location check (check in from anywhere).
# Set it back to "false" before a real service!
GEOFENCE_DISABLED=false

# --- Security ---
# Leaders don't share a password: each one has their own account (npm run leader:create creates the first).
# Secret that signs tokens/cookies and encrypts the leaders' authenticator (generate with: openssl rand -hex 32)
CHECKIN_SECRET=

# --- Guardian email on every check-in (SMTP) ---
# Gmail: SMTP_HOST=smtp.gmail.com · SMTP_PORT=465 · SMTP_USER=you@gmail.com · SMTP_PASS=app password (16 letters)
# Brevo: smtp-relay.brevo.com · 587 · SMTP login · SMTP key     Resend: smtp.resend.com · 465 · resend · API key
# Without these variables check-in works normally and the notice is recorded as "sem_config".
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="Check-in O2 Flag <you@gmail.com>"

# Public app URL (used by the QR code generator and email links)
PUBLIC_APP_URL=https://flag-checkin.vercel.app
