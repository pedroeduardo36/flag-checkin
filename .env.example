# --- Supabase (Project Settings > API) ---
SUPABASE_URL=https://SEU-PROJETO.supabase.co
# Chave "service_role" — SÓ no servidor. Nunca exponha no navegador.
SUPABASE_SERVICE_ROLE_KEY=

# --- Local do culto (pegue no Google Maps: botão direito > copiar coordenadas) ---
CHURCH_LAT=-15.8134283
CHURCH_LNG=-47.8435832
# Raio aceito em metros (GPS de celular dentro de prédio erra 20-60 m)
CHURCH_RADIUS_METERS=150
# Modo teste: "true" desliga a verificação de localização (check-in de qualquer lugar).
# Volte para "false" antes de usar no culto de verdade!
GEOFENCE_DISABLED=false

# --- Segurança ---
# Senha da área do pastor (/pastor): feed ao vivo dos check-ins e cadastro
PASTOR_PASSWORD=troque-esta-senha-do-pastor
# Segredo para assinar o token entre as etapas do check-in (gere com: openssl rand -hex 32)
CHECKIN_SECRET=

# --- E-mail para o responsável a cada check-in (SMTP) ---
# Gmail: SMTP_HOST=smtp.gmail.com · SMTP_PORT=465 · SMTP_USER=seu@gmail.com · SMTP_PASS=senha de app (16 letras)
# Brevo: smtp-relay.brevo.com · 587 · login SMTP · chave SMTP     Resend: smtp.resend.com · 465 · resend · API key
# Sem estas variáveis o check-in funciona normalmente e o aviso fica registrado como "sem_config".
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="Check-in O2 Flag <seu@gmail.com>"

# URL pública do app (usada pelo gerador de QR code)
PUBLIC_APP_URL=https://flag-checkin.vercel.app
